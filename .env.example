# VECTIS environment settings
# ---------------------------------------------------------------
# Copy this file to .env.local (on a computer) or enter the same
# names in Vercel -> Project -> Settings -> Environment Variables.
# NEVER commit real values to GitHub.

# Supabase -> Project Settings -> Data API -> Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Supabase -> Project Settings -> API Keys -> Publishable key
# (older projects call it the "anon public" key). Safe to expose:
# Row Level Security decides what it can read.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# The public address of the site (no trailing slash).
# Use the Vercel address until the domain is registered.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# NOTE: the Supabase service-role / secret key is deliberately NOT
# listed here. The application never needs it. Do not add it.
